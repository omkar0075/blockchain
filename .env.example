# Coral Testnet Configuration
CORAL_RPC_URL=https://coralrpc.mstblockchain.com
CHAIN_ID=54635
CONTRACT_ADDRESS=0xf8a978c5d5dfc258b5aefb4c3ea99b73615b7995
MEDWAY_CONTRACT_ADDRESS=0xf8a978c5d5dfc258b5aefb4c3ea99b73615b7995

# Relayer Key (pays gas for sponsored transactions)
# Stored in Hardhat keystore: npx hardhat keystore set CORAL_PRIVATE_KEY
# Or set via environment variable:
# CORAL_PRIVATE_KEY=0x...

# Institution Persistent Identities (Off-chain EIP-712 Signers, 0 gas required)
HOSPITAL_A_PRIVATE_KEY=0x...
HOSPITAL_A_ADDRESS=0x...
LAB_C_PRIVATE_KEY=0x...
LAB_C_ADDRESS=0x...

# PostgreSQL Database Configuration (Neon or Local Postgres)
# Neon Direct Connection (supports pg_advisory_xact_lock without pooler session affinity issues):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-dry-smoke-azgit8cd.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon Pooled Connection:
DATABASE_URL_POOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-dry-smoke-azgit8cd-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local Container / Self-Hosted Fallback
POSTGRES_USER=medway
POSTGRES_PASSWORD=medway_secure_pass
POSTGRES_DB=medway_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30.0

# Neon Managed Better Auth (Optional)
NEON_AUTH_BASE_URL=https://ep-dry-smoke-azgit8cd.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth

# Storage — S3-Compatible Object Storage (Off-Chain Evidence Vault / Media)
AWS_ENDPOINT_URL_S3=https://br-purple-cell-azlonjpm.storage.c-3.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
AWS_REGION=ap-southeast-1
S3_BUCKET=uploads
